# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://sriif:sriif_local_only@localhost:5433/sriif"
# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me"
# Local testing only: a fixed OTP instead of a random one. Leave empty in production.
DEV_OTP="123456"
# Turns on the API-backed store in the browser.
NEXT_PUBLIC_API="1"
